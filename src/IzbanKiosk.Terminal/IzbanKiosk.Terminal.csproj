<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>IZBAN-Kiosk</AssemblyName>
    <!-- Compared against the GitHub release tag by KioskUpdateService: bump this with
         every release, and tag the release with the same number. -->
    <Version>1.0.34</Version>
    <TargetFramework>net40</TargetFramework>
    <TargetFrameworkProfile>Client</TargetFrameworkProfile>
    <UseWPF>true</UseWPF>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\lib\net40\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IzbanKiosk.LegacyHardware.Contracts.Net40\IzbanKiosk.LegacyHardware.Contracts.Net40.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\izban_logo.png" />
    <Resource Include="Assets\izmirim_kart.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="KioskHardware.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
