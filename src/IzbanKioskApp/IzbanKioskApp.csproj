<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CodePage>65001</CodePage>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IzbanKiosk.Domain\IzbanKiosk.Domain.csproj" />
    <ProjectReference Include="..\IzbanKiosk.Application\IzbanKiosk.Application.csproj" />
    <ProjectReference Include="..\IzbanKiosk.Infrastructure\IzbanKiosk.Infrastructure.csproj" />
    <ProjectReference Include="..\IzbanKiosk.Hardware\IzbanKiosk.Hardware.csproj" />
    <ProjectReference Include="..\IzbanKiosk.Management.Contracts\IzbanKiosk.Management.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>