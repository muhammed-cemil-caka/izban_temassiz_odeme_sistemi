<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer-machine test host only. It never ships to the kiosk, which is why it
    targets a modern framework the build machine already has: the code under test is
    the net40/x86 Windows 7 stack, linked in as source so a single copy of each file
    serves both the kiosk build and the tests.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardware.Contracts\Models.cs"
             Link="Compatibility\Models.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardware.Contracts\NamedPipeFraming.cs"
             Link="Compatibility\NamedPipeFraming.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Interop\EmvRdr35NativeMethods.cs"
             Link="Compatibility\EmvRdr35NativeMethods.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Printer\LegacyPrinterHealthPolicy.cs"
             Link="Compatibility\LegacyPrinterHealthPolicy.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Card\LegacyCardLoader.cs"
             Link="Compatibility\LegacyCardLoader.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Configuration\HardwareOptions.cs"
             Link="Compatibility\HardwareOptions.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Nfc\ILegacyNfcDevice.cs"
             Link="Compatibility\ILegacyNfcDevice.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Card\TopUpSaga.cs"
             Link="Compatibility\TopUpSaga.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Card\ICardLoader.cs"
             Link="Compatibility\ICardLoader.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Card\NotAuthorisedCardLoader.cs"
             Link="Compatibility\NotAuthorisedCardLoader.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Pos\IPosTerminal.cs"
             Link="Compatibility\IPosTerminal.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Pos\NotConfiguredPosTerminal.cs"
             Link="Compatibility\NotConfiguredPosTerminal.cs" />
    <Compile Include="..\..\src\IzbanKiosk.LegacyHardwareBridge\Configuration\KioskAutoConfigurationPolicy.cs"
             Link="Compatibility\KioskAutoConfigurationPolicy.cs" />
    <Compile Include="..\..\src\IzbanKiosk.Terminal\ReceiptDocumentBuilder.cs"
             Link="Compatibility\ReceiptDocumentBuilder.cs" />
    <Compile Include="..\..\src\IzbanKiosk.Terminal\IzmirimKartNumber.cs"
             Link="Compatibility\IzmirimKartNumber.cs" />
    <Compile Include="..\..\src\IzbanKiosk.Terminal\Update\GitHubReleaseClient.cs"
             Link="Compatibility\GitHubReleaseClient.cs" />
  </ItemGroup>

</Project>
